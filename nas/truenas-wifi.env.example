# Copy to truenas-wifi.env (same directory as the truenas-wifi script).

# Where bundles are published (your copy of this repo).
GITHUB_REPO=swist/truenas-kernel-patches

# Regulatory domain (two-letter country code). Needed for 6 GHz / full power.
WIFI_COUNTRY=US

# Interface name, or "auto" for the first wireless interface.
WIFI_IFACE=auto

# Static addressing; leave empty for DHCP.
#WIFI_ADDRESS=192.168.1.20/24
#WIFI_GATEWAY=192.168.1.1

# 1 = when the running BE has no Wi-Fi kernel, clone it, patch the clone and
#     make it the next-boot BE. Pending TrueNAS updates are always patched.
AUTO_ACTIVATE=1

# 1 = reboot automatically after a next-boot BE was patched (e.g. right after
#     you applied a TrueNAS update with "reboot" unticked).
AUTO_REBOOT=0
