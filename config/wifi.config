#
# truenas-kernel-patches: re-enable Wi-Fi for Intel BE200 (iwlwifi, PCI 8086:272b)
#
# Merged AFTER TrueNAS's own fragments (debian_amd64.config -> truenas.config
# -> tn-production.config), so it overrides the "Disable WiFi and Wireless"
# block in scripts/package/truenas/truenas.config.
#
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_RFKILL=m
CONFIG_CFG80211=m
CONFIG_CFG80211_DEFAULT_PS=y
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=y
CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS=y
# No legacy wireless-extensions ioctl API; iw/wpa_supplicant use nl80211.
CONFIG_CFG80211_WEXT=n
CONFIG_MAC80211=m
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_MAC80211_MESH=n
CONFIG_MAC80211_LEDS=y

# Keep the build small: only the Intel vendor tree.
CONFIG_WLAN_VENDOR_ADMTEK=n
CONFIG_WLAN_VENDOR_ATH=n
CONFIG_WLAN_VENDOR_ATMEL=n
CONFIG_WLAN_VENDOR_BROADCOM=n
CONFIG_WLAN_VENDOR_INTERSIL=n
CONFIG_WLAN_VENDOR_MARVELL=n
CONFIG_WLAN_VENDOR_MEDIATEK=n
CONFIG_WLAN_VENDOR_MICROCHIP=n
CONFIG_WLAN_VENDOR_PURELIFI=n
CONFIG_WLAN_VENDOR_RALINK=n
CONFIG_WLAN_VENDOR_REALTEK=n
CONFIG_WLAN_VENDOR_RSI=n
CONFIG_WLAN_VENDOR_SILABS=n
CONFIG_WLAN_VENDOR_ST=n
CONFIG_WLAN_VENDOR_TI=n
CONFIG_WLAN_VENDOR_ZYDAS=n
CONFIG_WLAN_VENDOR_QUANTENNA=n
CONFIG_MAC80211_HWSIM=n
CONFIG_USB_NET_RNDIS_WLAN=n
CONFIG_VIRT_WIFI=n
CONFIG_IPW2100=n
CONFIG_IPW2200=n
CONFIG_IWLEGACY=n
CONFIG_IWL4965=n
CONFIG_IWL3945=n
# staging Wi-Fi drivers that Debian's config would otherwise pull in (6.12)
CONFIG_RTL8723BS=n
CONFIG_R8712U=n
CONFIG_RTL8192E=n
CONFIG_RTLLIB=n
CONFIG_VT6656=n
CONFIG_WFX=n

CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=m
CONFIG_IWLWIFI_LEDS=y
CONFIG_IWLDVM=n
# MVM drives BE200 on <= 6.14; MLD (new op-mode, 6.15+) drives it on 6.18.
# merge_config.sh only warns about symbols that don't exist on older trees.
CONFIG_IWLMVM=m
CONFIG_IWLMLD=m
CONFIG_IWLWIFI_OPMODE_MODULAR=y
CONFIG_IWLWIFI_DEBUG=n
